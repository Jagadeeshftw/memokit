# Coston2 EOA that pays the FDC attestation fee and the execute gas.
# Needed for deployment and for the end-to-end run. Fund from https://faucet.flare.network/coston2
PRIVATE_KEY=

# XRPL Testnet wallet seed. This account is the owner; its address derives the personal account.
# Create one at https://faucet.altnet.rippletest.net/accounts or via executor/src/xrpl/pay.ts.
XRPL_SEED=

# XRPL address the operator controls, registered as a memokit receiving address.
MEMOKIT_RECEIVING_ADDRESS=

# End-to-end target. Coston2 TESTearnXRP vault, asset FTestXRP (6 decimals).
MEMOKIT_VAULT=0xF97B2bBdB2f4a561806e5038a503eCA81554634E
MEMOKIT_DEPOSIT=1000000

# Optional overrides
# MEMOKIT_OWNER=
# MEMOKIT_SOURCE_ID=testXRP
# MEMOKIT_VALIDITY_SECONDS=86400
# MEMOKIT_TIMELOCK_SECONDS=3600
# COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc

# Payout / migration scenarios (executor/src/payout.ts, executor/src/migrateFunds.ts)
# Coston2 FTestXRP, 6 decimals. The asset the payout moves and the executor fee is paid in.
MEMOKIT_FXRP=0x0b6A3645c240605887a5532109323A3E12273dc7
# MIGRATE_AMOUNT=5000000

# --- Phase 4: the executor service (executor/src/service). See executor/DEPLOY.md. ---
# Minimum fee, in base units, that makes an instruction worth working, per token. A token that
# is not listed here is DECLINED: the service does not price tokens, you do. 100000 = 0.1 FTestXRP.
# MIN_FEE=0x0b6A3645c240605887a5532109323A3E12273dc7:100000
# STATE_FILE=.executor-state.json
# HTTP_PORT=8080
# READ_ONLY=1          # watch and serve the status API, never sign. No PRIVATE_KEY needed.
# DRY_RUN=1            # do everything except spend
# RELAY_RESCUES=false  # stop relaying 0xE0/0xE1/0xE2/0xFB, which pay nothing
# PAYLOADS_FILE=       # JSON map of transaction id -> payload, for 0xFC commit memos

# --- Phase 4: signing by QR (executor/src/cli/sign.ts) ---
# The XRPL address whose memokit account the instruction is for. No key is read.
# XRPL_OWNER_ADDRESS=
# SIGN_RECIPIENT=

# Xaman (formerly XUMM) developer credentials, from https://apps.xaman.dev.
# Only `npm run sign -- --xaman` needs these. Everything else works without them: the unsigned
# transaction and its QR are produced either way, and any XRPL wallet can sign them.
# XAMAN_API_KEY=
# XAMAN_API_SECRET=
