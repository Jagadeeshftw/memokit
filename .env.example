# Coston2 EOA that pays the FDC attestation fee and the execute gas.
# Needed for deployment and for the end-to-end run. Fund from https://faucet.flare.network/coston2
PRIVATE_KEY=

# XRPL Testnet wallet seed. This account is the owner; its address derives the personal account.
# Create one at https://faucet.altnet.rippletest.net/accounts or via executor/src/xrpl/pay.ts.
XRPL_SEED=

# XRPL address the operator controls, registered as a memokit receiving address.
MEMOKIT_RECEIVING_ADDRESS=

# End-to-end target. Coston2 TESTearnXRP vault, asset FTestXRP (6 decimals).
MEMOKIT_VAULT=0xF97B2bBdB2f4a561806e5038a503eCA81554634E
MEMOKIT_DEPOSIT=1000000

# Optional overrides
# MEMOKIT_OWNER=
# MEMOKIT_SOURCE_ID=testXRP
# MEMOKIT_VALIDITY_SECONDS=86400
# MEMOKIT_TIMELOCK_SECONDS=3600
# COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
